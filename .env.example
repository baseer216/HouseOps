# HouseOPS Configuration Template
# Copy this to /opt/houseops/.env on your server and fill in the values

# ==================== DATABASE ====================
# SQLite database path (optional, defaults to temp)
# DB_PATH=/opt/houseops/data/houseops.db

# ==================== PROXMOX ====================
# Proxmox VE IP or hostname
PVE_IP=YOUR_PROXMOX_IP

# Proxmox API Token (format: user@pam!tokenname)
PVE_TOKEN_ID=root@pam!houseops

# Proxmox API Secret (the token value, not the ID)
PVE_SECRET=your_pve_secret_here

# ==================== UNIFI ====================
# UniFi Dream Machine IP
UNIFI_IP=YOUR_UNIFI_IP

# UniFi API Key (from UniFi Controller Settings > API Keys)
UNIFI_API_KEY=your_unifi_api_key

# ==================== HOME ASSISTANT ====================
# Home Assistant URL (include /api suffix)
HA_URL=http://YOUR_HA_IP:8123/api

# Home Assistant Long-Lived Access Token
HA_TOKEN=your_ha_long_lived_token

# Home Assistant IP (for health monitoring, extracted from HA_URL if empty)
# HA_IP=YOUR_HA_IP

# ==================== NETWORK DEVICES ====================
# Gateway IP (for latency tracking and health monitoring)
GATEWAY_IP=YOUR_GATEWAY_IP

# ==================== SWITCHES (SNMP) ====================
# Core Switch
SWITCH_CORE_IP=YOUR_CORE_SWITCH_IP
SWITCH_CORE_COMM=public
SWITCH_CORE_MODEL=10G Managed

# Office Switch
SWITCH_OFFICE_IP=YOUR_OFFICE_SWITCH_IP
SWITCH_OFFICE_COMM=public
SWITCH_OFFICE_MODEL=2.5G Managed

# Studio Switch
SWITCH_STUDIO_IP=YOUR_STUDIO_SWITCH_IP
SWITCH_STUDIO_COMM=public
SWITCH_STUDIO_MODEL=2.5G Managed

# ==================== DNS / AD BLOCKING ====================
# Pi-hole 1
PIHOLE_1_URL=http://YOUR_PIHole_1_IP/api
PIHOLE_1_TOKEN=your_pihole_token
PIHOLE_1_NAME=Pi-hole Primary

# Pi-hole 2 (optional)
PIHOLE_2_URL=http://YOUR_PIHole_2_IP/api
PIHOLE_2_TOKEN=your_pihole_token
PIHOLE_2_NAME=Pi-hole Secondary

# AdGuard Home (optional)
ADGUARD_IP=YOUR_ADGUARD_IP
ADGUARD_USER=your_adguard_user
ADGUARD_PASS=your_adguard_password

# ==================== UPTIME KUMA ====================
# Uptime Kuma URL (optional)
UPTIME_KUMA_URL=http://YOUR_UPTIME_KUMA_IP:3001

# Comma-separated list of status page slugs to monitor
UPTIME_KUMA_SLUGS=internet,home-gear

# ==================== LATENCY TRACKING ====================
# WAN gateway IP (for latency tracking)
WAN_LATENCY_TARGET=YOUR_GATEWAY_IP

# Secondary WAN IP (optional)
WAN1_LATENCY_TARGET=YOUR_SECONDARY_WAN_IP
