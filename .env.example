# HouseOPS Configuration
DB_PATH=/opt/houseops/data/houseops.db

# UniFi Dream Router 7
UNIFI_IP=10.0.0.1
UNIFI_API_KEY=your_api_key_here

# Proxmox VE
PVE_IP=10.0.0.2
PVE_TOKEN_ID=root@pam!houseops
PVE_SECRET=your_token_secret

# Home Assistant (optional - for power monitoring)
HA_URL=http://10.0.0.3:8123/api
HA_TOKEN=your_ha_token

# SNMP Switches (optional)
SWITCH_CORE_IP=10.0.0.10
SWITCH_CORE_COMM=public
SWITCH_OFFICE_IP=10.0.0.11
SWITCH_OFFICE_COMM=public
SWITCH_STUDIO_IP=10.0.0.12
SWITCH_STUDIO_COMM=public
